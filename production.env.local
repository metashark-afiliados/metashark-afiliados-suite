# ==============================================================================
# [SECCIÓN 5] CARACTERÍSTICAS Y MODO DE MANTENIMIENTO (OPCIONAL)
# ==============================================================================
# Variables para controlar el comportamiento de la aplicación.

# Activa el modo de mantenimiento (true/false).
MAINTENANCE_MODE="false"
# Lista de IPs separadas por comas que pueden acceder en modo mantenimiento.
MAINTENANCE_IP_WHITELIST="127.0.0.1, ::1"


# ==============================================================================
# [SECCIÓN 6] HERRAMIENTAS DE DESARROLLO (SOLO LOCAL)
# ==============================================================================
# Estas variables solo tienen efecto en el entorno de desarrollo local.

# Controla el bypass de autenticación en el middleware y en getLayoutData.
# Establecer en "true" para deshabilitar la autenticación en desarrollo.
DEV_MODE_AUTH_BYPASS="false"

# Controla el bypass de la base de datos para el constructor de campañas.
# Establecer en "true" para usar datos de boilerplate en el builder.
DEV_MODE_BUILDER_BYPASS="false"

# Activa el análisis del bundle de la aplicación (true/false).
ANALYZE="true"


