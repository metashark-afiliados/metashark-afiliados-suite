# ==============================================================================
#           MANIFIESTO DE VARIABLES DE ENTORNO DE ÉLITE PARA CONVERTIKIT
# ==============================================================================
# SSoT: Esta es la Única Fuente de Verdad para la configuración del entorno.
# Formato: Jerarquizado y optimizado para despliegues en Vercel.
# ==============================================================================


# ==============================================================================
# [SECCIÓN 1] CONFIGURACIÓN CORE DE LA APLICACIÓN (REQUERIDO)
# ==============================================================================
# Estas variables definen el comportamiento fundamental y las URLs de la aplicación.
# NEXT_PUBLIC_SITE_URL se usa para generar URLs absolutas (ej. en emails).
# NEXT_PUBLIC_ROOT_DOMAIN se usa para la lógica de subdominios.
# En producción, ambos deberían ser el dominio principal (ej. "convertikit.com").

#NEXT_PUBLIC_SITE_URL="http://localhost:3000"
#NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"


# ==============================================================================
# [SECCIÓN 2] CONFIGURACIÓN DE SUPABASE (REQUERIDO)
# ==============================================================================
# Variables para la conexión con el backend de Supabase.
# Las claves `NEXT_PUBLIC_` son seguras para exponer en el cliente.
# Las claves sin prefijo son SECRETAS y solo deben ser accesibles en el servidor.

# --- Claves Públicas (Cliente) ---
#NEXT_PUBLIC_SUPABASE_URL="<YOUR_SUPABASE_URL>"
#NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"

# --- Claves Secretas (Servidor) ---
# Clave de servicio para operaciones de administrador (eludir RLS).
#SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY>"
# URL de conexión directa para migraciones o herramientas de DB (no usada por la app).
#SUPABASE_DB_URL_DIRECT="<YOUR_SUPABASE_DIRECT_DB_CONNECTION_STRING>"


# ==============================================================================
# [SECCIÓN 3] SERVICIOS DE TERCEROS (OPCIONAL)
# ==============================================================================

# --- API de Telemetría ---
# Secreto para autenticar las peticiones desde el middleware al API route de telemetría.
#TELEMETRY_API_SECRET="<A_SECURE_RANDOM_STRING_OF_32_CHARS_OR_MORE>"

# --- Sentry (Recomendado para Producción) ---
#SENTRY_DSN="<YOUR_SENTRY_DSN>"
#SENTRY_ORG="<YOUR_SENTRY_ORG>"
#SENTRY_PROJECT="<YOUR_SENTRY_PROJECT>"
#SENTRY_AUTH_TOKEN="<YOUR_SENTRY_AUTH_TOKEN>"


# ==============================================================================
# [SECCIÓN 4] CARACTERÍSTICAS Y MODO DE MANTENIMIENTO (OPCIONAL)
# ==============================================================================
# Variables para controlar el comportamiento de la aplicación.

# Activa el modo de mantenimiento (true/false).
#MAINTENANCE_MODE="false"
# Lista de IPs separadas por comas que pueden acceder en modo mantenimiento.
#MAINTENANCE_IP_WHITELIST="127.0.0.1, ::1"


# ==============================================================================
# [SECCIÓN 5] HERRAMIENTAS DE DESARROLLO (SOLO LOCAL)
# ==============================================================================
# Estas variables solo tienen efecto en el entorno de desarrollo local.

# ¡ADVERTENCIA DE SEGURIDAD! Si se establece a "true", se DESHABILITARÁ toda la
# lógica de autenticación y autorización en el middleware. Útil para depurar
# la UI de rutas protegidas sin necesidad de iniciar sesión.
# NUNCA establecer a "true" en producción.
#DEV_MODE_AUTH_BYPASS="false"

# Activa el modo de creación de campañas "boilerplate", que omite la base de datos
# y devuelve un ID estático para probar el flujo del constructor.
#DEV_MODE_BOILERPLATE_CREATION="false"
