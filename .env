# Documentación: https://www.prisma.io/docs/reference/database-reference/connection-urls

# URL para migraciones y `db pull`. Conexión directa a la base de datos.
# Reemplace [YOUR-PASSWORD] con su contraseña de la base de datos de Supabase.
DIRECT_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# URL para el cliente Prisma en tiempo de ejecución (ej. desde Server Actions).
# Usa el pooler de conexiones de Supabase para un rendimiento y escalabilidad óptimos.
# Reemplace [YOUR-PASSWORD] con su contraseña de la base de datos de Supabase.
DATABASE_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
